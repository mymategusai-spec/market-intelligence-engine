{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://market-intelligence-engine/schemas/domains/japan_ski_property/service_provider.json",
  "title": "Service provider (japan_ski_property)",
  "description": "A local professional or operator the owners would depend on: property managers, cleaners, snow clearing, maintenance, accountants, and the independent inspectors and builders needed for due diligence. Remote ownership from Australia is only viable if these people demonstrably exist in the chosen town, so this record is gating evidence, not a directory.",
  "type": "object",

  "properties": {
    "provider_id": { "type": "string" },
    "entity_id": { "type": ["string", "null"] },

    "provider_type": {
      "type": "string",
      "enum": [
        "property_manager", "booking_manager", "cleaner", "linen", "snow_clearing",
        "maintenance", "guest_services", "accountant", "tax_agent",
        "building_inspector", "surveyor", "architect", "construction_consultant",
        "builder", "project_manager", "other"
      ]
    },

    "person_name": { "type": ["string", "null"] },
    "company_name": { "type": ["string", "null"] },
    "region": { "type": "string" },
    "towns_served": { "type": "array", "items": { "type": "string" } },
    "services": { "type": "array", "items": { "type": "string" } },

    "languages": { "type": "array", "items": { "type": "string" } },
    "foreign_client_experience": { "type": ["string", "null"], "enum": ["extensive", "some", "none", "unknown", null] },
    "background": {
      "type": ["string", "null"],
      "enum": ["japanese", "australian", "new_zealand", "expat_other", "unknown", null]
    },
    "qualifications": { "type": ["string", "null"] },
    "mountain_building_experience": { "type": ["boolean", "null"] },

    "inspection_scope": {
      "type": ["string", "null"],
      "description": "For inspectors: what a survey actually covers. Scope varies widely and a limited scope can miss exactly the structural risk that matters."
    },
    "indicative_fee": { "oneOf": [{ "$ref": "../../core/common.json#/$defs/money" }, { "type": "null" }] },
    "fee_basis": { "type": ["string", "null"] },

    "independence": {
      "type": ["string", "null"],
      "enum": ["independent", "affiliated_with_agency", "vendor_appointed", "unknown", null],
      "description": "Selling agents must never be relied on for structural advice. Conflicts are recorded explicitly."
    },
    "conflicts_noted": { "type": ["string", "null"] },

    "contact_source_id": {
      "type": "string",
      "description": "Where this provider was found. Contact details are held only as published by the source."
    },
    "contacted": {
      "type": "boolean",
      "default": false,
      "description": "Always false unless the owner has explicitly approved contact. The engine never contacts providers autonomously."
    },
    "owner_approval_required": { "type": "boolean", "default": true },

    "confidence": { "$ref": "../../core/common.json#/$defs/confidence" },
    "notes": { "type": ["string", "null"] },
    "provenance": { "$ref": "../../core/common.json#/$defs/provenance" }
  },

  "required": ["provider_id", "provider_type", "region", "contact_source_id", "provenance"],
  "additionalProperties": false
}
